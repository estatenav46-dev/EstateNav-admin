# ==============================================================================
# EstateNav Admin Console - Environment Variables
# For Subdomain Deployment (e.g. admin.estatenav.in on Vercel):
# Add these under Project Settings → Environment Variables
# ==============================================================================

# Fixed Admin Login Credentials (Strict Server-Side Authentication)
ADMIN_EMAIL=admin@estatenav.in
ADMIN_PASSWORD=your_secure_password
ADMIN_SESSION_SECRET=a_random_32_character_string_for_session_encryption

# Firebase Admin SDK (Server Only - Full Firestore Access)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudinary (Direct Signed Uploads from Browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Main Website URL (for preview links & instant cache purges)
NEXT_PUBLIC_SITE_URL=https://estatenav.in

# Shared Revalidation Secret (matches main website)
REVALIDATION_SECRET=
